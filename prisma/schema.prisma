generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String         @id @default(uuid())
  email     String         @unique
  name      String?
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  
  apiKeys   ApiKey[]
  schemas   TargetSchema[]
  logs      WebhookLog[]
}

model ApiKey {
  id        String    @id @default(uuid())
  key       String    @unique // The actual x-aetherflow-api-key
  name      String    // e.g., "Production Stripe Key"
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  createdAt DateTime  @default(now())
  lastUsed  DateTime?
}

model TargetSchema {
  id          String       @id @default(uuid())
  name        String       // e.g., "Customer Signup Webhook"
  schemaDef   String       // The strict rules or JSON map for the AI
  userId      String
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  createdAt   DateTime     @default(now())
  logs        WebhookLog[]
}

model WebhookLog {
  id              String        @id @default(uuid())
  status          WebhookStatus 
  originalPayload Json          // What Stripe/GitHub originally sent
  healedPayload   Json?         // What the Groq AI generated
  errorMessage    String?
  computeTimeMs   Int           // To track latency

  schemaId        String?
  targetSchema    TargetSchema? @relation(fields: [schemaId], references: [id], onDelete: SetNull)
  
  userId          String
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  createdAt       DateTime      @default(now())
}

enum WebhookStatus {
  SUCCESS_NATIVE  // Passed strict Zod validation natively
  SUCCESS_HEALED  // Drift detected, AI patched it successfully
  FAILED          // AI failed to heal, unrecoverable
}