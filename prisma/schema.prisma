generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model IncomingWebhook {
  id          String       @id @default(uuid())
  receivedAt  DateTime     @default(now())
  rawPayload  Json
  source      String?      // e.g., "hubspot", "typeform"
  status      String       @default("pending") // pending, failed, healed, processed
  
  healingLogs HealingLog[]
}

model HealingLog {
  id                String          @id @default(uuid())
  webhookId         String
  interceptedAt     DateTime        @default(now())
  originalPayload   Json
  healedPayload     Json?
  aiConfidenceScore Float?
  errorMessage      String?

  webhook           IncomingWebhook @relation(fields: [webhookId], references: [id])
}